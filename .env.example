# Copy to .env and fill local values. Never commit real secrets.

# --- Frontend (Vite; public, non-privileged) ---
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-anon-key
VITE_APP_URL=http://localhost:5173
VITE_SUPPORT_EMAIL=support@example.com

# --- Supabase admin (server / worker / CLI only) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key-never-in-frontend
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- SMTP worker (Zoho Mail app password; never expose to the browser) ---
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@example.com
SMTP_PASS=replace-with-zoho-app-password
SMTP_FROM_NAME=IT Services
SMTP_FROM_EMAIL=noreply@example.com
SMTP_MOCK=true
WORKER_ID=local-worker-1
WORKER_POLL_MS=2000
WORKER_BATCH_SIZE=10
WORKER_LEASE_SECONDS=120
WORKER_HEALTH_PORT=8787

# --- App ---
APP_PUBLIC_URL=http://localhost:5173
UNSUBSCRIBE_SECRET=replace-with-long-random-string
TZ=Asia/Kolkata
NODE_ENV=development
